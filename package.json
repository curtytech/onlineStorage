{
  "name": "freeonlinestorage",
  "module": "index.ts",
  "main": "index.ts",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch index.ts",
    "start": "bun run index.ts",
    "build": "bun build index.ts --outdir dist --target bun",
    "migrate": "bun run src/db/migrate.ts",
    "rollback": "bun run src/db/migrate.ts rollback",
    "setup": "bun run src/setup.ts && bun run migrate",
    "start:prod": "NODE_ENV=production bun run setup && bun run index.ts",
    "serve": "NODE_ENV=production bun run build && bun run setup && bun dist/index.js"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/cors": "^2.8.19"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1"
  }
}